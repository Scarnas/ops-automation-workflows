    {
      "parameters": {
        "jsCode": "const order = $('Form Trigger').first().json;\nconst requestedSku = order.SKU;\nconst requestedQty = Number(order.Quantity);\nconst requestedWarehouse = order['Requested Warehouse'];\nif (!requestedSku || !(requestedQty > 0)) return []; // junk guard: no sku / non-positive qty\n\nconst rows = $input.all().map(i => i.json);\nconst movementRows = rows.filter(r => ('delta' in r) || ('type' in r && 'ts' in r));\nconst stockRows = rows.filter(r => !('delta' in r) && (('stock_qty' in r) || ('row_key' in r) || ('conflict' in r) || ('last_updated' in r)));\nconst leadRows  = rows.filter(r => !('delta' in r) && (('lead_time_days' in r) || ('lead_time' in r)) && !('stock_qty' in r) && !('row_key' in r));\n\nfunction buildOnHand(sRows,mRows){\n  const num=v=>(v===''||v==null||String(v).toLowerCase()==='n/a')?null:Number(v);\n  const K=(w,s)=>w+'|'+s; const anchor={};\n  for(const r of sRows){const w=r.warehouse_id??r.ID,s=r.sku;if(w==null||s==null)continue;anchor[K(w,s)]={qty:num(r.stock_qty??r.qty),lu:(r.last_updated||'')};}\n  const delta={};\n  for(const m of mRows){const w=m.warehouse_id,s=m.sku;if(w==null||s==null)continue;const k=K(w,s);const cut=anchor[k]?anchor[k].lu:'';if(String(m.ts||'')>cut)delta[k]=(delta[k]||0)+Number(m.delta||0);}\n  return {get(w,s){const k=K(w,s),a=anchor[k],d=delta[k]||0;if(!a)return null;return a.qty==null?null:a.qty+d;}};\n}\nconst oh = buildOnHand(stockRows, movementRows);\nconst avail = wh => { const v = oh.get(wh, requestedSku); return (v==null||v<0)?0:v; };\nconst allowBackorder = /^y/i.test(String(order['Allow Backorder'] ?? 'Yes').trim());\n\nconst created = new Date();\nconst orderId = 'ORD-' + created.toISOString().slice(0,10).replace(/-/g,'') + '-' + Math.random().toString(36).slice(2,6).toUpperCase();\nconst PLACE_LAG = 2, BUFFER = 3;\nconst leadRow = leadRows.find(r => r.sku === requestedSku);\nconst leadVal = leadRow ? Number(leadRow.lead_time_days ?? leadRow.lead_time) : NaN;\nconst mfgEta = PLACE_LAG + ((leadRow && !isNaN(leadVal)) ? leadVal : 21) + BUFFER;\n\nconst mkLine = (path, srcWh, qty, etaDays) => {\n  const etaDate = new Date(created); etaDate.setDate(etaDate.getDate() + etaDays);\n  return { json: {\n    order_id: orderId,\n    created_at: created.toISOString(),\n    customer: order['Customer Name'],\n    email: order['Email'] || null,\n    phone: order['Phone'] || null,\n    sku: requestedSku,\n    qty,\n    requested_warehouse: requestedWarehouse,\n    fulfillment_path: path,\n    source_warehouse: srcWh,\n    eta_days: etaDays,\n    eta_date: etaDate.toISOString().slice(0,10)\n  }};\n};\n\nconst others = stockRows\n  .filter(r => (r.warehouse_id ?? r.ID) !== requestedWarehouse && r.sku === requestedSku)\n  .map(r => ({ w:(r.warehouse_id ?? r.ID), avail: avail(r.warehouse_id ?? r.ID) }))\n  .filter(x => x.avail > 0)\n  .sort((a,b)=> b.avail - a.avail);\n\nconst localAvail = avail(requestedWarehouse);\nconst lines = [];\n\nif (localAvail >= requestedQty) {\n  lines.push(mkLine('Local', requestedWarehouse, requestedQty, 2));\n} else {\n  const fullOther = others.find(x => x.avail >= requestedQty);\n  if (fullOther) {\n    lines.push(mkLine('Warehouse Transfer', fullOther.w, requestedQty, 5));\n  } else if (allowBackorder && localAvail > 0) {\n    lines.push(mkLine('Local', requestedWarehouse, localAvail, 2));           // ship what's on the shelf now\n    const shortfall = requestedQty - localAvail;\n    const shortOther = others.find(x => x.avail >= shortfall);\n    if (shortOther) lines.push(mkLine('Warehouse Transfer', shortOther.w, shortfall, 5));\n    else            lines.push(mkLine('Manufacturer Order', null, shortfall, mfgEta));\n  } else {\n    lines.push(mkLine('Manufacturer Order', null, requestedQty, mfgEta));\n  }\n}\nreturn lines;"
      },
