    {
      "parameters": {
        "jsCode": "// One negative movement per Local/Transfer line (stock leaves the fulfilling warehouse).\nconst out = [];\nfor (const it of $input.all()) {\n  const o = it.json;\n  if (o.fulfillment_path !== 'Local' && o.fulfillment_path !== 'Warehouse Transfer') continue;\n  const warehouse = o.source_warehouse;\n  if (!warehouse) continue;\n  const mid = 'MOV-' + new Date().toISOString().slice(0,10).replace(/-/g,'') + '-' + Math.random().toString(36).slice(2,6).toUpperCase();\n  out.push({ json: {\n    movement_id: mid, ts: o.created_at, warehouse_id: warehouse, sku: o.sku,\n    delta: -Math.abs(Number(o.qty)), type: 'ORDER', ref: o.order_id, note: o.fulfillment_path\n  }});\n}\nreturn out;"
      },
