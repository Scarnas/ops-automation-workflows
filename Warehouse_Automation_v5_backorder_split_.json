    {
      "parameters": {
        "jsCode": "// One PENDING purchase order per Manufacturer Order line (incl. backordered shortfalls).\nconst leads = $('Get Lead Time for SKU').all().map(i => i.json);\nconst out = [];\nfor (const it of $input.all()) {\n  const o = it.json;\n  if (o.fulfillment_path !== 'Manufacturer Order') continue;\n  const lr = leads.find(r => r.sku === o.sku);\n  const leadRaw = lr ? (lr.lead_time_days ?? lr.lead_time) : null;\n  const lead = (leadRaw === '' || leadRaw == null) ? 21 : Number(leadRaw);\n  const supplier = lr ? ((lr['supplier '] ?? lr.supplier ?? 'Unknown').toString().trim()) : 'Unknown';\n  const poId = 'PO-' + new Date().toISOString().slice(0,10).replace(/-/g,'') + '-' + Math.random().toString(36).slice(2,6).toUpperCase();\n  out.push({ json: {\n    po_id: poId, created_at: o.created_at, sku: o.sku, qty: o.qty,\n    warehouse_id: o.requested_warehouse, supplier, source: 'demand',\n    linked_order_id: o.order_id, lead_time_days: lead, buffer_days: 3,\n    placed_at: '', expected_date: '', status: 'PENDING', received_at: '', movement_posted: '', note: ''\n  }});\n}\nreturn out;"
      },
