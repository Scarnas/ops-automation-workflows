      "id": "53e0ce6f-2c65-4125-9830-82396f064330",
      "name": "CleadLeads"
    },
    {
      "parameters": {
        "jsCode": "const bestBySku = {};\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const existing = bestBySku[row.sku];\n\n  if (!existing || (row.lead_time_days !== null && (existing.lead_time_days === null || row.lead_time_days < existing.lead_time_days))) {\n    bestBySku[row.sku] = row;\n  }\n}\n\nreturn Object.values(bestBySku).map(row => ({ json: row }));"
      },
