      "name": "Dedupe"
    },
    {
      "parameters": {
        "jsCode": "const groups = {};\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const key = `${row.warehouse_id}|${row.sku}`;\n\n  if (!groups[key]) {\n    groups[key] = { ...row, conflict: false };\n    continue;\n  }\n\n  const existing = groups[key];\n\n  if (row.stock_qty !== null && existing.stock_qty !== null && row.stock_qty !== existing.stock_qty) {\n    existing.conflict = true;\n  }\n\n  const rowIsNewer = (row.last_updated || \"\") > (existing.last_updated || \"\");\n  const rowHasData = row.stock_qty !== null;\n  const existingHasData = existing.stock_qty !== null;\n\n  if (rowIsNewer || (!existingHasData && rowHasData)) {\n    groups[key] = { ...row, conflict: existing.conflict };\n  }\n}\n\nreturn Object.values(groups).map(row => ({ json: row }));"
      },
