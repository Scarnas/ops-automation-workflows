    {
      "parameters": {
        "jsCode": "const skuMap = {\n  \"rebar12mm\": \"REBAR-12MM\",\n  \"armatura12mm\": \"REBAR-12MM\",\n  \"cement25kg\": \"CEMENT-25KG\",\n  \"cementas25kg\": \"CEMENT-25KG\",\n  \"mediena50x100\": \"TIMBER-50X100\",\n  \"timber50x100\": \"TIMBER-50X100\",\n  \"termoizoliacija50mm\": \"INSULATION-50MM\",\n  \"insulation50mm\": \"INSULATION-50MM\",\n  \"plytupalete\": \"BRICK-PALLET\",\n  \"brickpallet\": \"BRICK-PALLET\"\n};\n\nfunction normalizeKey(raw) {\n  return raw.toLowerCase().replace(/[\\s\\-]/g, \"\");\n}\n\nconst output = [];\n\nfor (const item of $input.all()) {\n  const raw = item.json;\n  const sku = skuMap[normalizeKey(raw.sku_raw)] || null;\n\n  let leadTimeDays = null;\n\nif (raw.lead_time_raw) {\n  const text = String(raw.lead_time_raw).toLowerCase();\n  const match = text.match(/\\d+/);\n  if (match) {\n    const number = parseInt(match[0], 10);\n    leadTimeDays = (text.includes(\"week\") || text.includes(\"savait\")) ? number * 7 : number;\n  }\n}\n\n  output.push({\n    json: {\n      sku: sku,\n      supplier: raw.supplier || null,\n      lead_time_days: leadTimeDays,\n      notes: raw.notes || null\n    }\n  });\n}\n\nreturn output;"
      },
