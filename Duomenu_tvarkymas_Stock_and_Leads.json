    {
      "parameters": {
        "jsCode": "function normalizeKey(raw) {\n  return raw\n    .toLowerCase()\n    .normalize(\"NFD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\") // strips diacritics: š→s, ė→e, ž→z, ū→u\n    .replace(/[\\s\\-]/g, \"\");\n}\n\nconst skuMap = {\n  \"rebar12mm\": \"REBAR-12MM\", \"armatura12mm\": \"REBAR-12MM\", \"armature12mm\": \"REBAR-12MM\",\n  \"cement25kg\": \"CEMENT-25KG\", \"cementas25kg\": \"CEMENT-25KG\",\n  \"mediena50x100\": \"TIMBER-50X100\", \"timber50x100\": \"TIMBER-50X100\",\n  \"termoizoliacija50mm\": \"INSULATION-50MM\", \"insulation50mm\": \"INSULATION-50MM\",\n  \"plytupalete\": \"BRICK-PALLET\", \"plytupaletee\": \"BRICK-PALLET\", \"brickpallet\": \"BRICK-PALLET\"\n};\n\nconst warehouseMap = {\n  \"vilniuswh\": \"VLN-01\", \"vln01\": \"VLN-01\", \"vilniuswarehouse\": \"VLN-01\", \"warehousevilnius\": \"VLN-01\",\n  \"kaunaswh\": \"KNS-02\", \"kaunassandelis\": \"KNS-02\", \"kns02\": \"KNS-02\",\n  \"klaipedawh\": \"KLP\", \"klaipedasandelis\": \"KLP\", \"klp\": \"KLP\",\n  \"siauliaiwh\": \"SIA-05\", \"siauliaisandelis\": \"SIA-05\", \"sia05\": \"SIA-05\",\n  \"panevezyswh\": \"PNV-06\", \"panevezys\": \"PNV-06\",\n  \"alytuswh\": \"ALY-07\", \"alytaussandelis\": \"ALY-07\",\n  \"marijampolewh\": \"MRJ-04\",\n\"marijampolessandelis\": \"MRJ-04\",\n  \"utenawh\": \"UTN-08\", \"utn08\": \"UTN-08\"\n};\n\nfunction parseQty(raw) {\n  if (raw === null || raw === undefined || raw === \"\") return null; // unknown\n  const text = String(raw).trim().toLowerCase();\n  if (text === \"n/a\") return null;          // unknown\n  if (text === \"out of stock\") return 0;     // known: zero, not missing\n  const number = parseInt(text, 10);\n  if (isNaN(number) || number < 0) return null; // bad data treated as unknown\n  return number;\n}\n\nfunction parseDate(raw) {\n  if (!raw) return null;\n  const text = String(raw).trim();\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(text)) return text;\n  const slash = text.match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})$/);\n  if (slash) return `${slash[3]}-${slash[2]}-${slash[1]}`;\n  const hyphen = text.match(/^(\\d{2})-(\\d{2})-(\\d{4})$/);\n  if (hyphen) return `${hyphen[3]}-${hyphen[2]}-${hyphen[1]}`;\n  return null;\n}\n\nconst output = [];\n\nfor (const item of $input.all()) {\n  const raw = item.json;\n  output.push({\n    json: {\n      warehouse_id: warehouseMap[normalizeKey(raw.warehouse_raw)] || null,\n      sku: skuMap[normalizeKey(raw.sku_raw)] || null,\n      stock_qty: parseQty(raw.qty_raw),\n      last_updated: parseDate(raw.last_updated_raw),\n      notes: raw.notes || null\n    }\n  });\n}\n\nreturn output;"
      },
