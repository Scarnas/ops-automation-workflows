    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"claude-3-5-haiku-20241022\", max_tokens: 300, system: \"You triage inbound email for a general company inbox (info@/sales@). Classify each email into exactly one category: sales_lead (new business inquiry, pricing question, demo request, partnership pitch), support (existing customer issue, bug report, how-to question, complaint), invoice (billing, payment, invoice copy requests, accounts payable/receivable), or spam (unsolicited marketing, phishing, irrelevant). Respond with ONLY valid JSON, no markdown, no commentary, in exactly this shape: {\\\"category\\\": \\\"sales_lead|support|invoice|spam\\\", \\\"confidence\\\": 0.0-1.0, \\\"reasoning\\\": \\\"one short sentence\\\"}\", messages: [ { role: \"user\", content: \"Subject: \" + ($json.subject || \"\") + \"\\nFrom: \" + ($json.from || \"\") + \"\\nBody:\\n\" + ($json.textPlain || $json.snippet || \"\") } ] }) }}",
        "options": {}
      },
      "id": "577b0e40-3047-40fd-87b4-0ab080a4e8ae",
      "name": "Classify with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1072,
        336
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const originalData = $('Config').item.json;\nconst apiResponse = items[0].json;\n\nlet category = 'support';\nlet confidence = 0;\nlet reasoning = '';\n\ntry {\n  const text = apiResponse.content[0].text;\n  const parsed = JSON.parse(text);\n  const allowed = ['sales_lead', 'support', 'invoice', 'spam'];\n  category = allowed.includes(parsed.category) ? parsed.category : 'support';\n  confidence = typeof parsed.confidence === 'number' ? parsed.confidence : 0;\n  reasoning = parsed.reasoning || '';\n} catch (e) {\n  reasoning = 'Classifier output could not be parsed; routed to Support as a safe fallback. Raw error: ' + e.message;\n}\n\nreturn [{ json: { ...originalData, category, confidence, reasoning } }];"
      },
