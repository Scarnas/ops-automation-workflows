    {
      "parameters": {
        "jsCode": "function addDays(dateStr,n){const d=new Date(String(dateStr).slice(0,10)+'T00:00:00Z');if(isNaN(d))return null;d.setUTCDate(d.getUTCDate()+Number(n));return d.toISOString().slice(0,10);}\nconst isSet=v=>v!==''&&v!=null&&v!==undefined;\nconst out=[];\nfor(const it of $input.all()){\n  const r={...it.json}; let changed=false;\n  // placed but no expected_date -> compute real ETA and flip to PLACED\n  if(isSet(r.placed_at)&&!isSet(r.expected_date)){\n    r.expected_date=addDays(r.placed_at, Number(r.lead_time_days||0)+Number(r.buffer_days||0));\n    if(String(r.status).toUpperCase()==='PENDING') r.status='PLACED';\n    changed=true;\n  }\n  // received & not yet posted -> mark posted (the receipt movement is emitted by the other branch)\n  if(String(r.status).toUpperCase()==='RECEIVED' && String(r.movement_posted).toLowerCase()!=='yes'){\n    r.movement_posted='yes';\n    if(!isSet(r.received_at)) r.received_at=new Date().toISOString();\n    changed=true;\n  }\n  if(changed) out.push({json:r});\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "468d8624-71d7-4945-9326-8b5c35c27288",
      "name": "Compute PO Writebacks"
    },
    {
      "parameters": {
        "jsCode": "const isSet=v=>v!==''&&v!=null&&v!==undefined;\nconst out=[];\nfor(const it of $input.all()){\n  const r=it.json;\n  if(String(r.status).toUpperCase()==='RECEIVED' && String(r.movement_posted).toLowerCase()!=='yes'){\n    out.push({json:{\n      movement_id:'MOV-REC-'+r.po_id,\n      ts:(isSet(r.received_at)?r.received_at:new Date().toISOString()),\n      warehouse_id:r.warehouse_id, sku:r.sku,\n      delta:Math.abs(Number(r.qty)), type:'RECEIPT', ref:r.po_id, note:'PO received'\n    }});\n  }\n}\nreturn out;"
      },
