      "id": "116d5883-ed3a-41f6-a58a-09f75cd01c37",
      "name": "Get Orderslog",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "name": "Google Sheets account"
        }
      },
      "notes": "Read Orderslog to find the customer email by linked_order_id."
    },
    {
      "parameters": {
        "jsCode": "// Firm-date follow-up: when a PO is placed (placed_at set, expected_date not yet computed),\n// email the linked customer the confirmed delivery date. Fires exactly once per PO —\n// next run expected_date is filled, so the row no longer qualifies.\nfunction addDays(dateStr,n){const d=new Date(String(dateStr).slice(0,10)+'T00:00:00Z');if(isNaN(d))return null;d.setUTCDate(d.getUTCDate()+Number(n));return d.toISOString().slice(0,10);}\nconst isSet=v=>v!==''&&v!=null&&v!==undefined;\nconst orders=$('Get Orderslog').all().map(i=>i.json);\nconst out=[];\nfor(const it of $input.all()){\n  const r=it.json;\n  if(!(isSet(r.placed_at) && !isSet(r.expected_date))) continue;\n  const expected=addDays(r.placed_at, Number(r.lead_time_days||0)+Number(r.buffer_days||0));\n  const ord=orders.find(o=>(o.order_id||'')===(r.linked_order_id||''));\n  const email=ord?(ord.email||'').toString().trim():'';\n  if(!email) continue;\n  const name=ord?(ord.customer||''):'';\n  out.push({json:{\n    email,\n    subject:`Confirmed delivery date — ${r.sku} (x${r.qty}) — ${expected}`,\n    body:`Hi ${name},\\n\\nGood news — the backordered part of your order (${r.qty} × ${r.sku}) has now been placed with our supplier and has a confirmed estimated delivery date: ${expected}.\\n\\nWe'll let you know if anything changes.\\n\\nThanks,\\nOperations Team`\n  }});\n}\nreturn out;"
      },
