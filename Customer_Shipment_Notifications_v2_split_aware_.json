    {
      "parameters": {
        "jsCode": "// Group new Orderslog rows by order_id -> ONE email per order.\n// A split order (2 lines) becomes a single email describing each part + its ETA.\nconst groups = {};\nfor (const _item of $input.all()) {\n  const o = _item.json;\n  const id = o.order_id || ('NOID-' + Math.random());\n  (groups[id] = groups[id] || []).push(o);\n}\n\nconst out = [];\nfor (const id of Object.keys(groups)) {\n  const lines = groups[id];\n  const rank = { 'Local':0, 'Warehouse Transfer':1, 'Manufacturer Order':2 };\n  const pathOf = o => o['fulfilment path'] || o.fulfillment_path || '';\n  lines.sort((a,b) => (rank[pathOf(a)] ?? 9) - (rank[pathOf(b)] ?? 9));\n\n  const first = lines[0];\n  const name  = (first.customer || '').toString();\n  const email = (first.email || '').toString().trim() || null;\n  const phone = (first.phone || '').toString().trim() || null;\n\n  const describe = o => {\n    const path = pathOf(o);\n    const src  = o.source_warehouse || o.source || o.requested_warehouse || '';\n    const eta  = o.eta_date;\n    if (path === 'Local')              return `  • ${o.qty} × ${o.sku} — dispatching from ${src} now, estimated arrival ${eta}`;\n    if (path === 'Warehouse Transfer') return `  • ${o.qty} × ${o.sku} — transferring from our ${src} location, estimated arrival ${eta}`;\n    if (path === 'Manufacturer Order') return `  • ${o.qty} × ${o.sku} — on backorder (made to order by our supplier), estimated ${eta}`;\n    return `  • ${o.qty} × ${o.sku} — estimated ${eta}`;\n  };\n\n  const totalQty = lines.reduce((s,l)=> s + Number(l.qty||0), 0);\n  const skus  = [...new Set(lines.map(l=>l.sku))];\n  const paths = [...new Set(lines.map(pathOf))];\n  const etas  = lines.map(l=>l.eta_date).filter(Boolean).sort();\n  const lastEta = etas[etas.length-1];\n  const isSplit = lines.length > 1;\n\n  let subject, body;\n  if (isSplit) {\n    subject = `Your order ${id} — ${lines.length} shipments, completion by ${lastEta}`;\n    body =\n`Hi ${name},\n\nYour order ${id} is confirmed. To get it to you as fast as possible, it's arriving in ${lines.length} parts:\n\n${lines.map(describe).join('\\n')}\n\nThe earlier items ship first; the backordered portion follows. Full order completed by ${lastEta}.\n\nReply to this email with any questions.\n\nThanks,\nOperations Team`;\n  } else {\n    const o = lines[0];\n    subject = `Your order update — ${o.sku} (x${o.qty}) — ETA ${o.eta_date}`;\n    body =\n`Hi ${name},\n\nYour order is confirmed.\n\n${describe(o).trim().replace(/^• /,'')}\n\nReply to this email with any questions.\n\nThanks,\nOperations Team`;\n  }\n\n  out.push({ json: {\n    email_found: !!email,\n    subject, body,\n    customer: name,\n    sku: skus.join(', '),\n    qty: totalQty,\n    eta_date: lastEta,\n    path: paths.join(' + '),\n    email, phone,\n    status: email ? 'SENT' : 'NO_EMAIL',\n    notified_at: new Date().toISOString()\n  }});\n}\nreturn out;"
      },
