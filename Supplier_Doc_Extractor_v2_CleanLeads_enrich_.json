      "name": "Extract PDF Text",
      "notes": "Binary property must match the form file field. If extraction fails, check the property name (often 'Supplier_Document')."
    },
    {
      "parameters": {
        "jsCode": "const text = ($json.text || '').toString().slice(0, 60000);\nconst schema = '{\"supplier\":string,\"doc_type\":string,\"doc_date\":\"YYYY-MM-DD\",\"currency\":string,\"line_items\":[{\"sku\":string,\"description\":string,\"qty\":number,\"unit_price\":number}]}';\nconst prompt = 'Extract exactly this JSON schema from the logistics supplier document below ' +\n  '(it may be an invoice, packing slip, or delivery note). Use null for anything missing. ' +\n  'Return ONLY minified JSON - no markdown, no prose.\\n\\nSCHEMA: ' + schema + '\\n\\nDOCUMENT:\\n' + text;\n\nreturn [{ json: { body: {\n  model: 'claude-haiku-4-5-20251001',\n  max_tokens: 4096,\n  system: 'You extract structured data from logistics supplier documents. You always return valid JSON only.',\n  messages: [{ role: 'user', content: prompt }]\n} } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        0
      ],
      "id": "8a13c970-ade4-4ab4-b558-06ee3e6b4de6",
      "name": "Build Request"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1152,
        0
      ],
      "id": "0d714d42-ad4f-4a59-81ac-936763dd4676",
      "name": "Claude — Extract",
      "credentials": {
        "httpHeaderAuth": {
          "name": "Header Auth account"
        }
      },
      "notes": "Create an 'Header Auth' credential with Name = x-api-key, Value = your Anthropic API key. Adjust the model in Build Request if needed."
    },
    {
      "parameters": {
        "jsCode": "const resp = $json;\nlet text = '';\nif (Array.isArray(resp.content)) text = resp.content.map(c => c.text || '').join('');\nelse text = resp.text || resp.completion || '';\n\nlet data = null;\ntry { data = JSON.parse(text); } catch (e) {\n  const m = text.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { data = JSON.parse(m[0]); } catch (_) {} }\n}\nif (!data) return [{ json: { error: 'could not parse model output', raw: String(text).slice(0, 500) } }];\n\nconst skuMap = {\n  rebar12mm:'REBAR-12MM', armatura12mm:'REBAR-12MM', cement25kg:'CEMENT-25KG', cementas25kg:'CEMENT-25KG',\n  mediena50x100:'TIMBER-50X100', timber50x100:'TIMBER-50X100', termoizoliacija50mm:'INSULATION-50MM',\n  insulation50mm:'INSULATION-50MM', plytupalete:'BRICK-PALLET', brickpallet:'BRICK-PALLET'\n};\nconst norm = s => { if (!s) return null; const k = String(s).toLowerCase().replace(/[\\s\\-]/g,''); return skuMap[k] || String(s).toUpperCase(); };\nconst now = new Date().toISOString();\nconst items = Array.isArray(data.line_items) ? data.line_items : [];\n\nif (!items.length) return [{ json: {\n  supplier: data.supplier || null, doc_type: data.doc_type || null, doc_date: data.doc_date || null,\n  sku: null, description: '(no line items parsed)', qty: null, unit_price: null,\n  currency: data.currency || null, parsed_at: now\n} }];\n\nreturn items.map(li => ({ json: {\n  supplier: data.supplier || null, doc_type: data.doc_type || null, doc_date: data.doc_date || null,\n  sku: norm(li.sku), description: li.description || null, qty: (li.qty ?? null), unit_price: (li.unit_price ?? null),\n  currency: data.currency || null, parsed_at: now\n} }));"
      },
