      "notes": "Create an 'InboundDocuments' sheet with headers: supplier, doc_type, doc_date, sku, description, qty, unit_price, currency, parsed_at."
    },
    {
      "parameters": {
        "jsCode": "// Enrich CleanLeads from extracted supplier line items.\n// Only rows with a real SKU and a price; de-dupe by SKU (last price wins).\n// NOTE: the CleanLeads header is 'supplier ' WITH a trailing space - keep it.\nconst out = new Map();\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  if (!j.sku || j.unit_price == null) continue;\n  const row = { sku: j.sku, last_price: j.unit_price, last_price_at: j.parsed_at };\n  if (j.supplier) row['supplier '] = j.supplier;   // trailing space is intentional\n  if (j.currency) row.price_currency = j.currency;\n  out.set(j.sku, row);\n}\nreturn Array.from(out.values()).map(json => ({ json }));"
      },
